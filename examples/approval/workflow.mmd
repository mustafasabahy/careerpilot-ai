---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	human_review(human_review)
	execute_action(execute_action)
	finish_without_execution(finish_without_execution)
	__end__([<p>__end__</p>]):::last
	__start__ --> human_review;
	human_review -. &nbsp;execute&nbsp; .-> execute_action;
	human_review -. &nbsp;finish&nbsp; .-> finish_without_execution;
	execute_action --> __end__;
	finish_without_execution --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

