---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	validate_request(validate_request)
	load_job(load_job)
	load_profile(load_profile)
	normalize_requirements(normalize_requirements)
	calculate_baseline(calculate_baseline)
	validate_assessment(validate_assessment)
	return_result(return_result)
	missing_information(missing_information)
	fail(fail)
	__end__([<p>__end__</p>]):::last
	__start__ --> validate_request;
	calculate_baseline --> validate_assessment;
	load_job -.-> fail;
	load_job -. &nbsp;continue&nbsp; .-> load_profile;
	load_profile -.-> fail;
	load_profile -. &nbsp;continue&nbsp; .-> normalize_requirements;
	normalize_requirements --> calculate_baseline;
	validate_assessment -.-> missing_information;
	validate_assessment -. &nbsp;complete&nbsp; .-> return_result;
	validate_request -.-> fail;
	validate_request -. &nbsp;continue&nbsp; .-> load_job;
	fail --> __end__;
	missing_information --> __end__;
	return_result --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
