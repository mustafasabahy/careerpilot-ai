---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	authorize(authorize)
	search(search)
	normalize(normalize)
	deduplicate(deduplicate)
	assess(assess)
	fail(fail)
	__end__([<p>__end__</p>]):::last
	__start__ --> authorize;
	assess -. &nbsp;continue&nbsp; .-> __end__;
	assess -.-> fail;
	authorize -.-> fail;
	authorize -. &nbsp;continue&nbsp; .-> search;
	deduplicate -. &nbsp;continue&nbsp; .-> assess;
	deduplicate -.-> fail;
	normalize -. &nbsp;continue&nbsp; .-> deduplicate;
	normalize -.-> fail;
	search -.-> fail;
	search -. &nbsp;continue&nbsp; .-> normalize;
	fail --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
