# Safe local defaults. Keep real values in an ignored .env or process environment.
CAREERPILOT_ENVIRONMENT=development
CAREERPILOT_LOG_LEVEL=INFO
CAREERPILOT_LLM_PROVIDER=mock
CAREERPILOT_LLM_MODEL=fixture-v1
CAREERPILOT_LLM_TIMEOUT_SECONDS=30
CAREERPILOT_LLM_MAX_RETRIES=0
CAREERPILOT_LLM_MAX_OUTPUT_TOKENS=4096

# Real mode is opt-in. Replace the model above with a native structured-output model.
# CAREERPILOT_LLM_PROVIDER=openai
# CAREERPILOT_LLM_MODEL=your-structured-output-model
# OPENAI_MODEL=your-model-id  # accepted as a shared model setting
# OPENAI_API_KEY=replace-with-a-project-api-key
# CAREERPILOT_CHAT_MODE=llm
# CAREERPILOT_CHAT_MODEL=your-chat-model-id
# A Codex/ChatGPT subscription is not an application API credential.
# Live tests additionally require --run-live-llm and CAREERPILOT_RUN_LIVE_TESTS=1.
